{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cresco.local/contracts/document/v1.schema.json",
  "title": "Cresco Document v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "documentId", "documentType", "session"],
  "properties": {
    "schema": { "const": "cresco-document/v1" },
    "version": { "const": 1 },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 160 },
    "documentType": {
      "enum": ["page", "header", "footer", "single", "archive", "search", "404", "loop-item", "component", "woo-single", "woo-archive", "popup"]
    },
    "metadata": { "type": "object" },
    "session": {
      "type": "object",
      "required": ["schema", "version", "documentId", "nodes"],
      "properties": {
        "schema": { "const": "cresco-session/v1" },
        "version": { "type": "integer", "minimum": 1 },
        "documentId": { "type": "string" },
        "nodes": { "type": "array" }
      }
    }
  }
}
