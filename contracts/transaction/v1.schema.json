{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cresco.local/contracts/transaction/v1.schema.json",
  "title": "Cresco Transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "label", "source", "commands"],
  "properties": {
    "schema": { "const": "cresco-transaction/v1" },
    "id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "label": { "type": "string", "minLength": 1, "maxLength": 160 },
    "source": {
      "enum": ["canvas", "structure", "inspector", "keyboard", "clipboard", "component", "ai", "import", "system", "editor"]
    },
    "startedAt": { "type": "string", "maxLength": 80 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "../command/v1.schema.json" }
    }
  }
}
