{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cresco.local/contracts/command/v1.schema.json",
  "title": "Cresco Command v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "command", "target", "payload"],
  "properties": {
    "schema": { "const": "cresco-command/v1" },
    "command": {
      "enum": [
        "node.insert",
        "node.delete",
        "node.move",
        "node.duplicate",
        "node.group",
        "node.rename",
        "node.lock",
        "node.visibility",
        "props.update",
        "style.update",
        "style.reset",
        "responsive.update",
        "responsive.reset",
        "state.update",
        "state.reset",
        "customCss.update",
        "component.create",
        "component.apply",
        "component.detach",
        "ai.applyPatch",
        "node.props.set",
        "node.style.set",
        "node.responsive.set",
        "node.custom-css.set",
        "node.remove",
        "node.replace",
        "patch.apply"
      ]
    },
    "source": {
      "enum": ["canvas", "structure", "inspector", "keyboard", "clipboard", "component", "ai", "import", "system", "editor"]
    },
    "transactionId": { "type": "string", "maxLength": 160 },
    "transactionLabel": { "type": "string", "maxLength": 160 },
    "startedAt": { "type": "string", "maxLength": 80 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope"],
      "properties": {
        "scope": { "enum": ["page", "document", "subtree", "widget", "selection"] },
        "nodeId": { "type": ["string", "null"] },
        "nodeIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "payload": { "type": "object" }
  }
}
